<Window x:Class="Calculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2006"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculator"
        mc:Ignorable="d"
        Title="Calculator"
        Width="380"
        Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">

    <Window.DataContext>
        <local:CalculatorViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Palette -->
        <Color x:Key="AccentColor">#2D7FF9</Color>
        <SolidColorBrush x:Key="WindowBackground" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="DigitButtonBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DigitButtonHoverBrush" Color="#E8EBEF"/>
        <SolidColorBrush x:Key="FunctionButtonBrush" Color="#CDD3DA"/>
        <SolidColorBrush x:Key="FunctionButtonHoverBrush" Color="#BCC3CC"/>
        <SolidColorBrush x:Key="AccentButtonBrush" Color="#2D7FF9"/>
        <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="#1E66D6"/>
        <SolidColorBrush x:Key="DigitText" Color="#1A1C1E"/>
        <SolidColorBrush x:Key="FunctionText" Color="#3A3F45"/>
        <SolidColorBrush x:Key="ButtonText" Color="#1A1C1E"/>

        <!-- Base button template -->
        <ControlTemplate x:Key="CalculatorButtonTemplate" TargetType="ButtonBase">
            <Border x:Name="border"
                    CornerRadius="8"
                    Margin="4"
                    Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background"
                            Value="{DynamicResource DigitButtonHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DigitButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource CalculatorButtonTemplate}"/>
            <Setter Property="Background" Value="{StaticResource DigitButtonBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DigitText}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style x:Key="FunctionButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource CalculatorButtonTemplate}"/>
            <Setter Property="Background" Value="{StaticResource FunctionButtonBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource FunctionText}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource CalculatorButtonTemplate}"/>
            <Setter Property="Background" Value="{StaticResource AccentButtonBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Calculator body -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- display -->
                <RowDefinition Height="*"/>     <!-- buttons -->
            </Grid.RowDefinitions>

            <!-- Display -->
            <Grid Grid.Row="0" Margin="16,16,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="HistoryLabel"
                           Grid.Row="0"
                           Text="{Binding HistoryLabel, Mode=OneWay}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           FontSize="14"
                           Foreground="#8A9099"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock x:Name="DisplayLabel"
                           Grid.Row="1"
                           Text="{Binding Display, Mode=OneWay}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           FontSize="44"
                           FontWeight="Light"
                           Foreground="{StaticResource DigitText}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,4,0,0"/>
            </Grid>

            <!-- Buttons: 4 columns x 6 rows -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Row 0: top functions -->
                <Button Grid.Row="0" Grid.Column="0" Content="AC"
                        Style="{StaticResource FunctionButtonStyle}"
                        Command="{Binding ClearCommand}"/>
                <Button Grid.Row="0" Grid.Column="1" Content="CE"
                        Style="{StaticResource FunctionButtonStyle}"
                        Command="{Binding ClearEntryCommand}"/>
                <Button Grid.Row="0" Grid.Column="2" Content="⌫"
                        Style="{StaticResource FunctionButtonStyle}"
                        Command="{Binding BackspaceCommand}"/>
                <Button Grid.Row="0" Grid.Column="3" Content="÷"
                        Style="{StaticResource FunctionButtonStyle}"
                        Command="{Binding DivideCommand}"/>

                <!-- Row 1 -->
                <Button Grid.Row="1" Grid.Column="0" Content="7" Style="{StaticResource DigitButtonStyle}" Command="{Binding Digit7Command}"/>
                <Button Grid.Row="1" Grid.Column="1" Content="8" Style="{StaticResource DigitButtonStyle}" Command="{Binding Digit8Command}"/>
                <Button Grid.Row="1" Grid.Column="2" Content="9" Style="{StaticResource DigitButtonStyle}" Command="{Binding Digit9Command}"/>
                <Button Grid.Row="1" Grid.Column="3" Content="×" Style="{StaticResource FunctionButtonStyle}" Command="{Binding MultiplyCommand}"/>

                <!-- Row 2 -->
                <Button Grid.Row="2" Grid.Column="0" Content="4" Style="{StaticResource DigitButtonStyle}" Command="{Binding Digit4Command}"/>
                <Button Grid.Row="2" Grid.Column="1" Content="5" Style="{StaticResource DigitButtonStyle}" Command="{Binding Digit5Command}"/>
                <Button Grid.Row="2" Grid.Column="2" Content="6" Style="{StaticResource DigitButtonStyle}" Command="{Binding Digit6Command}"/>
                <Button Grid.Row="2" Grid.Column="3" Content="−" Style="{StaticResource FunctionButtonStyle}" Command="{Binding SubtractCommand}"/>

                <!-- Row 3 -->
                <Button Grid.Row="3" Grid.Column="0" Content="1" Style="{StaticResource DigitButtonStyle}" Command="{Binding Digit1Command}"/>
                <Button Grid.Row="3" Grid.Column="1" Content="2" Style="{StaticResource DigitButtonStyle}" Command="{Binding Digit2Command}"/>
                <Button Grid.Row="3" Grid.Column="2" Content="3" Style="{StaticResource DigitButtonStyle}" Command="{Binding Digit3Command}"/>
                <Button Grid.Row="3" Grid.Column="3" Content="+" Style="{StaticResource FunctionButtonStyle}" Command="{Binding AddCommand}"/>

                <!-- Row 4 -->
                <Button Grid.Row="4" Grid.Column="0" Content="%" Style="{StaticResource FunctionButtonStyle}" Command="{Binding PercentCommand}"/>
                <Button Grid.Row="4" Grid.Column="1" Content="0" Style="{StaticResource DigitButtonStyle}" Command="{Binding Digit0Command}"/>
                <Button Grid.Row="4" Grid.Column="2" Content="±" Style="{StaticResource FunctionButtonStyle}" Command="{Binding NegateCommand}"/>
                <Button Grid.Row="4" Grid.Column="3" Content="=" Style="{StaticResource AccentButtonStyle}" Command="{Binding EqualsCommand}"/>

                <!-- Row 5: decimal (spans 3 columns) -->
                <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Content="." Style="{StaticResource FunctionButtonStyle}" Command="{Binding DecimalCommand}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
